:root{--accent:{{ settings.accent | default: '#E50914' }};--bg:{{ settings.background | default: '#080808' }};--surface:{{ settings.surface | default: '#111111' }};--text:{{ settings.text | default: '#F5F1EA' }};--muted:{{ settings.muted | default: '#AAA39B' }};--line:rgba(255,255,255,.10);--serif:'Playfair Display',Georgia,serif;--sans:'DM Sans',Arial,sans-serif}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font-family:var(--sans);font-size:15px;line-height:1.6}a{color:inherit;text-decoration:none}img{display:block;max-width:100%}button,input,select{font:inherit}.container{width:min(1240px,calc(100% - 48px));margin:auto}.eyebrow{font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--muted)}.serif{font-family:var(--serif)}.accent{color:var(--accent);font-style:italic}.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:48px;padding:0 22px;border:1px solid rgba(255,255,255,.28);background:rgba(0,0,0,.18);color:#fff;font-weight:600;letter-spacing:.04em;text-transform:uppercase;font-size:11px;transition:.25s}.btn:hover{border-color:var(--accent);background:var(--accent);color:#fff}.btn--solid{background:var(--accent);border-color:var(--accent);color:#fff;box-shadow:0 10px 30px rgba(229,9,20,.16)}.section{padding:96px 0}.section-head{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:36px}.section-title{font:500 clamp(32px,4vw,54px)/1.05 var(--serif);margin:8px 0 0}.section-copy{color:var(--muted);max-width:560px}.announcement{background:#0a0a0a;border-bottom:1px solid var(--line);font-size:11px;letter-spacing:.14em;text-align:center;text-transform:uppercase;padding:9px 16px;color:#d8d1c8}.site-header{position:sticky;top:0;z-index:20;background:rgba(8,8,8,.90);backdrop-filter:blur(18px);border-bottom:1px solid var(--line)}.header-row{min-height:76px;display:flex;align-items:center;gap:28px}.brand{width:142px;height:60px;display:flex;align-items:center}.brand img{width:100%;height:100%;object-fit:contain;object-position:left center;filter:none}.brand-text{font:600 23px/1 var(--serif);letter-spacing:-.04em;color:#fff}.brand-text .accent{color:var(--accent)}.nav{display:flex;gap:22px;margin-left:auto}.nav a{font-size:11px;letter-spacing:.11em;text-transform:uppercase;color:#f1ece5;opacity:.9}.nav a:hover{color:#fff;opacity:1}.header-actions{display:flex;gap:8px;margin-left:12px}.icon-btn{width:42px;height:38px;border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.02);color:#fff;display:grid;place-items:center;cursor:pointer}.menu-btn{display:none}.hero{position:relative;min-height:760px;display:flex;align-items:end;overflow:hidden;background:#050505}.hero-media{position:absolute;inset:0;background:radial-gradient(ellipse at 78% 46%,rgba(229,9,20,.38) 0%,rgba(120,5,12,.20) 22%,transparent 48%),radial-gradient(ellipse at 18% 50%,rgba(255,255,255,.055),transparent 36%),linear-gradient(90deg,#070707 0%,rgba(7,7,7,.88) 42%,rgba(7,7,7,.42) 72%,rgba(7,7,7,.72) 100%)}.hero-media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.7}.hero-content{position:relative;z-index:1;padding:130px 0 90px;max-width:760px}.hero h1{font:500 clamp(54px,8vw,106px)/.93 var(--serif);letter-spacing:-.05em;margin:18px 0 24px;color:#fff;text-shadow:0 2px 28px rgba(0,0,0,.35)}.hero p{max-width:580px;color:#eee8df;font-size:17px}.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:32px}.trust-strip{display:flex;gap:32px;flex-wrap:wrap;margin-top:48px;color:#f0e9df;font-size:10px;letter-spacing:.14em;text-transform:uppercase}.trust-strip span{display:flex;align-items:center;gap:8px}.trust-strip i{width:5px;height:5px;border-radius:50%;background:var(--accent)}.category-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.category-card{position:relative;min-height:310px;overflow:hidden;border:1px solid var(--line);background:#0e0e0e}.category-card img{width:100%;height:100%;object-fit:cover;opacity:.72;transition:transform .5s,opacity .5s}.category-card:hover img{transform:scale(1.04);opacity:.9}.category-overlay{position:absolute;inset:0;padding:24px;display:flex;align-items:end;background:linear-gradient(transparent 35%,rgba(0,0,0,.86))}.category-overlay strong{font:500 27px var(--serif)}.category-overlay span{display:block;color:#bdb6ae;font-size:10px;letter-spacing:.15em;text-transform:uppercase;margin-top:3px}.product-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.product-card{position:relative}.product-image{aspect-ratio:1/1.12;background:#151515;overflow:hidden;position:relative}.product-image img{width:100%;height:100%;object-fit:cover;transition:transform .45s}.product-card:hover .product-image img{transform:scale(1.035)}.product-meta{padding:15px 2px}.product-title{font-size:14px;margin:0 0 5px}.product-price{font-size:13px;color:#c9c2b9}.badge{position:absolute;left:12px;top:12px;background:#fff;color:#080808;padding:5px 8px;font-size:9px;text-transform:uppercase;letter-spacing:.12em;z-index:1}.combo{background:#0d0d0d;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.combo-grid{display:grid;grid-template-columns:1.1fr .9fr;min-height:580px}.combo-copy{padding:86px 8vw 70px 0;display:flex;flex-direction:column;justify-content:center}.combo-copy h2{font:500 clamp(42px,6vw,80px)/.95 var(--serif);margin:14px 0 20px}.combo-copy p{color:var(--muted);max-width:510px}.combo-list{display:flex;flex-direction:column;margin-top:34px}.combo-item{border-top:1px solid var(--line);padding:18px 0;display:flex;justify-content:space-between;gap:20px}.combo-item:last-child{border-bottom:1px solid var(--line)}.combo-item strong{font-family:var(--serif);font-size:20px;font-weight:500}.combo-visual{position:relative;overflow:hidden;min-height:580px;background:radial-gradient(circle at 50% 45%,rgba(229,9,20,.35),transparent 30%),#080808}.combo-visual img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.65}.combo-mark{position:absolute;inset:auto 40px 40px auto;font:italic 500 76px var(--serif);color:rgba(255,255,255,.85)}.trust{background:#f0ece5;color:#171513}.trust .eyebrow{color:#77716b}.trust-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#d6d0c8;margin-top:36px}.trust-card{background:#f0ece5;padding:32px 26px;min-height:190px}.trust-card strong{font:500 24px var(--serif);display:block;margin-bottom:8px}.trust-card p{color:#6e6861;margin:0;font-size:13px}.finder{background:#131313}.finder-box{border:1px solid var(--line);padding:55px;display:flex;align-items:center;justify-content:space-between;gap:40px}.finder-box h2{font:500 clamp(34px,5vw,62px) var(--serif);margin:10px 0}.finder-box p{color:var(--muted);max-width:560px}.finder-options{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;min-width:360px}.finder-options a{border:1px solid var(--line);padding:16px;color:#d8d1c8;font-size:11px;text-transform:uppercase;letter-spacing:.08em}.finder-options a:hover{border-color:var(--accent);color:#fff}.story{display:grid;grid-template-columns:.85fr 1.15fr;gap:80px;align-items:center}.story h2{font:500 clamp(42px,5vw,70px)/.98 var(--serif);margin:12px 0 20px}.story p{color:var(--muted);font-size:16px;max-width:620px}.story-image{aspect-ratio:4/5;background:#111;overflow:hidden}.story-image img{width:100%;height:100%;object-fit:cover}.site-footer{border-top:1px solid var(--line);padding:65px 0 30px;background:#050505}.footer-grid{display:grid;grid-template-columns:1.4fr repeat(3,1fr);gap:40px}.footer-brand{font:500 34px var(--serif)}.footer-brand span{color:var(--accent);font-style:italic}.footer-title{font-size:10px;text-transform:uppercase;letter-spacing:.16em;color:#77716b;margin-bottom:16px}.footer-links{display:grid;gap:9px;color:#b9b2aa;font-size:13px}.footer-bottom{border-top:1px solid var(--line);margin-top:55px;padding-top:18px;display:flex;justify-content:space-between;gap:20px;color:#77716b;font-size:11px}.collection-head{padding:70px 0 45px;border-bottom:1px solid var(--line)}.collection-head h1,.page-head h1{font:500 clamp(48px,7vw,86px)/.95 var(--serif);margin:12px 0}.collection-body{padding:48px 0 90px}.collection-toolbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:28px;color:var(--muted);font-size:12px}.product-page{display:grid;grid-template-columns:1.05fr .95fr;gap:70px;padding:70px 0 100px}.product-gallery{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.product-gallery img{width:100%;background:#111}.product-info{position:sticky;top:110px;height:max-content}.product-info h1{font:500 clamp(42px,5vw,68px)/1 var(--serif);margin:10px 0 12px}.product-info .price{font-size:18px;margin-bottom:28px}.product-description{color:var(--muted);max-width:560px}.variant-row{margin:28px 0}.variant-row label{display:block;font-size:10px;text-transform:uppercase;letter-spacing:.14em;margin-bottom:8px}.variant-row select{width:100%;background:#0e0e0e;border:1px solid var(--line);color:#fff;padding:13px}.add-form{display:flex;gap:10px}.qty{width:74px;background:#0e0e0e;border:1px solid var(--line);color:#fff;text-align:center}.cart{padding:75px 0 110px}.cart h1,.page-head h1{font:500 clamp(48px,7vw,86px)/.95 var(--serif)}.cart-row{display:grid;grid-template-columns:90px 1fr auto auto;gap:22px;align-items:center;padding:18px 0;border-top:1px solid var(--line)}.cart-row img{width:90px;height:100px;object-fit:cover;background:#111}.cart-total{margin-left:auto;width:min(420px,100%);border-top:1px solid var(--line);padding-top:22px;margin-top:25px}.total-line{display:flex;justify-content:space-between;font-size:18px;margin-bottom:20px}.empty{padding:70px 0;text-align:center;color:var(--muted)}.page-head{padding:75px 0 30px}.page-content{padding:10px 0 90px;max-width:850px;color:#c7c0b8}.toast{position:fixed;right:20px;bottom:20px;z-index:50;background:#fff;color:#111;padding:12px 18px;font-size:12px;transform:translateY(130%);transition:.3s}.toast.is-visible{transform:none}@media(max-width:1000px){.nav{display:none}.menu-btn{display:grid}.header-actions{margin-left:auto}.category-grid,.product-grid{grid-template-columns:repeat(2,1fr)}.combo-grid,.story,.product-page{grid-template-columns:1fr}.combo-copy{padding:70px 0}.combo-visual{min-height:480px}.trust-grid{grid-template-columns:repeat(2,1fr)}.finder-box{display:block}.finder-options{margin-top:30px;min-width:0}.product-info{position:static}.footer-grid{grid-template-columns:1fr 1fr}.hero{min-height:650px}}@media(max-width:600px){.container{width:min(100% - 30px,1240px)}.section{padding:70px 0}.header-row{min-height:68px}.brand{width:128px}.hero-content{padding:100px 0 65px}.hero h1{font-size:55px}.hero p{font-size:15px}.trust-strip{gap:15px}.category-grid,.product-grid,.trust-grid,.finder-options,.product-gallery{grid-template-columns:1fr 1fr;gap:10px}.category-card{min-height:220px}.section-head{display:block}.section-head .btn{margin-top:20px}.finder-box{padding:32px 24px}.story{gap:35px}.footer-grid{grid-template-columns:1fr 1fr}.footer-bottom{display:block}.footer-bottom span{display:block;margin-top:8px}.cart-row{grid-template-columns:64px 1fr auto}.cart-row img{width:64px;height:78px}.cart-row .line-price{display:none}.product-page{gap:35px}.product-gallery{grid-template-columns:1fr}.add-form{flex-wrap:wrap}.qty{height:48px}}
