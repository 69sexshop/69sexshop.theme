<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.background | default: '#050505' }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 96 }}">
    {%- endif -%}
    <title>{{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>
    {%- if page_description != blank -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}
    {{ content_for_header }}
    <style>
      :root{
        --accent:{{ settings.accent | default: '#E60012' }};
        --accent-2:{{ settings.accent_glow | default: '#FF1020' }};
        --bg:{{ settings.background | default: '#050505' }};
        --surface:{{ settings.surface | default: '#111111' }};
        --text:{{ settings.text | default: '#F5F3EF' }};
        --muted:{{ settings.muted | default: '#A7A7A7' }};
      }
    </style>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&display=swap" rel="stylesheet">
    {{ 'styles.css' | asset_url | stylesheet_tag }}
    <script>
      window.theme = {
        currency: {{ cart.currency.iso_code | json }},
        routes: {
          cart: {{ routes.cart_url | json }},
          all: {{ routes.all_products_collection_url | json }},
          cartJs: {{ routes.cart_url | append: '.js' | json }},
          cartAdd: {{ routes.cart_add_url | append: '.js' | json }},
          cartChange: {{ routes.cart_change_url | append: '.js' | json }},
          products: {{ routes.root_url | append: 'products/' | json }}
        }
      };
      {%- if settings.show_age_notice -%}
      try { if (!localStorage.getItem('69_age_ok')) { document.documentElement.classList.add('age-lock'); } }
      catch (e) { document.documentElement.classList.add('age-lock'); }
      {%- endif -%}
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </head>
  <body class="template-{{ template.name }}{% if template.suffix != blank %} template-{{ template.suffix }}{% endif %}">
    <a class="skip-link" href="#MainContent">Saltar al contenido</a>
    {% section 'announcement' %}
    {% section 'header' %}
    <main id="MainContent" role="main">{{ content_for_layout }}</main>
    {% section 'footer' %}
    {% render 'cart-drawer' %}
    {%- if settings.show_age_notice -%}
      {% render 'age-gate' %}
    {%- endif -%}
    {%- if settings.show_advisor -%}
      {% render 'advisor' %}
    {%- endif -%}
    {%- assign wa = settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' -%}
    {%- capture wa_href -%}
      {%- if wa != blank -%}https://wa.me/{{ wa }}{% if settings.whatsapp_message != blank %}?text={{ settings.whatsapp_message | url_encode }}{% endif %}{%- else -%}{{ routes.root_url }}pages/contacto{%- endif -%}
    {%- endcapture -%}
    <a class="wa-float" href="{{ wa_href | strip }}"{% if wa != blank %} target="_blank" rel="noopener"{% endif %} aria-label="Escribir por WhatsApp">
      {% render 'icon', name: 'whatsapp' %}
    </a>
    <div class="toast" id="Toast" role="status" aria-live="polite"></div>
  </body>
</html>
