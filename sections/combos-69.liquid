<section class="section combo"><div class="container"><div class="combo-grid"><div class="combo-copy"><div class="eyebrow">Los combos 69</div><h2>Una experiencia <span class="accent">completa.</span></h2><p>{{ section.settings.text }}</p><div class="combo-list">{% for block in section.blocks %}<a class="combo-item" href="{{ block.settings.url }}" {{ block.shopify_attributes }}><strong>{{ block.settings.title }}</strong><span>→</span></a>{% endfor %}</div></div><div class="combo-visual">{% if section.settings.image %}<img src="{{ section.settings.image | image_url: width: 1200 }}" alt="" loading="lazy">{% endif %}<div class="combo-mark">69</div></div></div></div></section>
{% schema %}{"name":"Combos 69","max_blocks":6,"settings":[{"type":"image_picker","id":"image","label":"Imagen"},{"type":"textarea","id":"text","label":"Texto","default":"Combinaciones pensadas para regalar, experimentar y llevar la experiencia 69 a otro nivel."}],"blocks":[{"type":"combo","name":"Combo","settings":[{"type":"text","id":"title","label":"Nombre","default":"Combo Rompe Diablas"},{"type":"url","id":"url","label":"Enlace"}]}],"presets":[{"name":"Combos 69","blocks":[{"type":"combo","settings":{"title":"Combo Rompe Diablas"}},{"type":"combo","settings":{"title":"Combo Destroyer"}},{"type":"combo","settings":{"title":"Combo Titán"}},{"type":"combo","settings":{"title":"Combo Pecado"}}]}]}{% endschema %}
