<section class="section combo">
  <div class="container">
    <div class="combo-grid">
      <div class="combo-copy">
        <h2>{{ section.settings.title }}</h2>
        <p>{{ section.settings.text }}</p>
        <div class="combo-list">
          {%- for block in section.blocks -%}
            {%- if block.settings.product != blank -%}
              {%- assign combo_url = block.settings.product.url -%}
            {%- else -%}
              {%- capture combo_url -%}{% render 'safe-url', url: block.settings.url %}{%- endcapture -%}
            {%- endif -%}
            <a class="combo-item" href="{{ combo_url | strip }}" {{ block.shopify_attributes }}>
              <strong>{{ block.settings.title }}</strong>
              {%- if block.settings.badge != blank -%}<span class="combo-badge">{{ block.settings.badge }}</span>{%- endif -%}
              <span class="combo-go">{% render 'icon', name: 'arrow' %}</span>
            </a>
          {%- endfor -%}
        </div>
      </div>
      <div class="combo-visual">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: '' }}
        {%- endif -%}
        <div class="combo-mark">69</div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Combos 69",
  "max_blocks": 8,
  "settings": [
    {"type":"text","id":"title","label":"Título","default":"Los combos 69"},
    {"type":"image_picker","id":"image","label":"Imagen (packaging negro mate con logo)"},
    {"type":"textarea","id":"text","label":"Texto","default":"Combinaciones pensadas para regalar, probar o compartir, en empaque neutro."}
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo",
      "settings": [
        {"type":"text","id":"title","label":"Nombre","default":"Combo Rompe Diablas"},
        {"type":"text","id":"badge","label":"Etiqueta (opcional)"},
        {"type":"product","id":"product","label":"Producto del combo","info":"Si lo eliges, el combo lleva directo a su página. Si no, va a la colección de combos."},
        {"type":"url","id":"url","label":"Enlace alternativo"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Combos 69",
      "blocks": [
        {"type":"combo","settings":{"title":"Combo Rompe Diablas","badge":"Más vendido"}},
        {"type":"combo","settings":{"title":"Combo Titán"}},
        {"type":"combo","settings":{"title":"Combo Destroyer"}},
        {"type":"combo","settings":{"title":"Combo Pecado"}},
        {"type":"combo","settings":{"title":"Combo 69"}}
      ]
    }
  ]
}
{% endschema %}
