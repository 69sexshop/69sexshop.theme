<section class="collection-head"><div class="container"><div class="eyebrow">Colección</div><h1>{{ collection.title }}</h1>{% if collection.description != blank %}<p class="section-copy">{{ collection.description }}</p>{% endif %}</div></section><section class="collection-body"><div class="container"><div class="collection-toolbar"><span>{{ collection.products_count }} productos</span></div><div class="product-grid">{% for product in collection.products %}{% render 'product-card', product: product %}{% endfor %}</div></div></section>
