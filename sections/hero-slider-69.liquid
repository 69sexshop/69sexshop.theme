{%- assign total = section.blocks.size -%}
<section class="slider is-playing" data-slider data-autoplay="{{ section.settings.autoplay }}" data-interval="{{ section.settings.interval }}" aria-roledescription="carousel" aria-label="Destacados">
  <div class="slider-track" data-slider-track>
    {%- for block in section.blocks -%}
      {%- capture slide_title -%}
        <span class="hero-line">{{ block.settings.line_1 }}</span>
        <span class="hero-line accent">{{ block.settings.line_accent }}</span>
        <span class="hero-line">{{ block.settings.line_3 }}</span>
      {%- endcapture -%}
      <article class="slide{% if forloop.first %} is-active{% endif %}" role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} de {{ total }}" {{ block.shopify_attributes }}>
        <div class="slide-media">
          {%- if block.settings.image != blank -%}
            {%- if forloop.first -%}
              {{ block.settings.image | image_url: width: 2200 | image_tag: loading: 'eager', fetchpriority: 'high', alt: '' }}
            {%- else -%}
              {{ block.settings.image | image_url: width: 2200 | image_tag: loading: 'lazy', alt: '' }}
            {%- endif -%}
          {%- endif -%}
        </div>
        <span class="slide-count" aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>
        <div class="container">
          <div class="slide-content">
            {%- if forloop.first -%}
              <h1 class="slide-title">{{ slide_title }}</h1>
            {%- else -%}
              <h2 class="slide-title">{{ slide_title }}</h2>
            {%- endif -%}
            {%- if block.settings.text != blank -%}<p class="slide-text">{{ block.settings.text }}</p>{%- endif -%}
            <div class="hero-actions slide-actions">
              {%- if block.settings.button_label != blank -%}
                {%- capture b1 -%}{% render 'safe-url', url: block.settings.button_url %}{%- endcapture -%}
                <a class="btn btn--solid" href="{{ b1 | strip }}">{{ block.settings.button_label }}</a>
              {%- endif -%}
              {%- if block.settings.button2_label != blank -%}
                {%- capture b2 -%}{% render 'safe-url', url: block.settings.button2_url %}{%- endcapture -%}
                <a class="btn" href="{{ b2 | strip }}">{{ block.settings.button2_label }}</a>
              {%- endif -%}
            </div>
          </div>
        </div>
      </article>
    {%- endfor -%}
  </div>

  {%- if total > 1 -%}
    <div class="slider-ui">
      <div class="container slider-ui-row">
        <div class="slider-dots">
          {%- for block in section.blocks -%}
            <button class="slider-dot{% if forloop.first %} is-active{% endif %}" type="button" data-slide-dot aria-label="Ir a la diapositiva {{ forloop.index }}"><span></span></button>
          {%- endfor -%}
        </div>
        <div class="slider-buttons">
          <button class="icon-btn slider-toggle" type="button" data-slide-toggle aria-label="Pausar presentación">
            <svg class="icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path class="ico-pause" d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"/><path class="ico-play" d="M8 5l11 7-11 7z"/></svg>
          </button>
          <button class="icon-btn slider-prev" type="button" data-slide-prev aria-label="Anterior">{% render 'icon', name: 'arrow' %}</button>
          <button class="icon-btn" type="button" data-slide-next aria-label="Siguiente">{% render 'icon', name: 'arrow' %}</button>
        </div>
      </div>
    </div>
  {%- endif -%}

  <ul class="trust-strip slider-trust container">
    {%- if section.settings.guarantee_1 != blank -%}<li>{{ section.settings.guarantee_1 }}</li>{%- endif -%}
    {%- if section.settings.guarantee_2 != blank -%}<li>{{ section.settings.guarantee_2 }}</li>{%- endif -%}
    {%- if section.settings.guarantee_3 != blank -%}<li>{{ section.settings.guarantee_3 }}</li>{%- endif -%}
  </ul>
</section>
{% schema %}
{
  "name": "Deslizador de inicio",
  "max_blocks": 6,
  "settings": [
    {"type":"checkbox","id":"autoplay","label":"Cambiar de diapositiva automáticamente","default":true},
    {"type":"range","id":"interval","label":"Segundos por diapositiva","min":2,"max":12,"step":1,"default":4},
    {"type":"text","id":"guarantee_1","label":"Garantía 1","default":"Envío discreto"},
    {"type":"text","id":"guarantee_2","label":"Garantía 2","default":"Pago seguro"},
    {"type":"text","id":"guarantee_3","label":"Garantía 3","default":"Privacidad total"}
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Diapositiva",
      "settings": [
        {"type":"image_picker","id":"image","label":"Imagen de fondo (editorial, oscura)"},
        {"type":"text","id":"line_1","label":"Título, línea 1","default":"El placer"},
        {"type":"text","id":"line_accent","label":"Título, línea en rojo cursiva","default":"tiene un nuevo"},
        {"type":"text","id":"line_3","label":"Título, línea 3","default":"lugar."},
        {"type":"textarea","id":"text","label":"Texto","default":"Una selección de productos para adultos pensada para quienes buscan una experiencia íntima y una compra privada."},
        {"type":"text","id":"button_label","label":"Botón principal","default":"Explorar tienda"},
        {"type":"url","id":"button_url","label":"Enlace principal"},
        {"type":"text","id":"button2_label","label":"Botón secundario"},
        {"type":"url","id":"button2_url","label":"Enlace secundario"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Deslizador de inicio",
      "blocks": [
        {"type":"slide"},
        {"type":"slide","settings":{"line_1":"Combos","line_accent":"listos para","line_3":"regalar.","text":"Elige un combo armado y recíbelo en empaque neutro.","button_label":"Ver combos"}},
        {"type":"slide","settings":{"line_1":"Lencería","line_accent":"que se siente","line_3":"como tú.","text":"Piezas seleccionadas para sentirte sensual, con estilo.","button_label":"Ver lencería"}},
        {"type":"slide","settings":{"line_1":"Lo más","line_accent":"deseado","line_3":"de la tienda.","text":"Una selección corta para elegir sin dudar.","button_label":"Ver más deseados"}}
      ]
    }
  ]
}
{% endschema %}
