<section class="section">
  <div class="container">
    <div class="section-head">
      <div>
        <h2 class="section-title">{{ section.settings.title }}</h2>
      </div>
      {%- if section.settings.text != blank -%}<p class="section-copy">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="category-grid">
      {%- for block in section.blocks -%}
        {%- capture card_url -%}{% render 'safe-url', url: block.settings.url %}{%- endcapture -%}
        <a class="category-card" href="{{ card_url | strip }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.title }}
          {%- endif -%}
          <div class="category-overlay">
            <div>
              <strong>{{ block.settings.title }}</strong>
              {%- if block.settings.subtitle != blank -%}<span>{{ block.settings.subtitle }}</span>{%- endif -%}
            </div>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Categorías 69",
  "max_blocks": 8,
  "settings": [
    {"type":"text","id":"title","label":"Título","default":"¿Qué estás buscando?"},
    {"type":"textarea","id":"text","label":"Texto","default":"Una navegación sencilla para llegar rápido a lo que quieres."}
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoría",
      "settings": [
        {"type":"image_picker","id":"image","label":"Imagen"},
        {"type":"text","id":"title","label":"Título","default":"Para ella"},
        {"type":"text","id":"subtitle","label":"Subtítulo","default":"Descubrir"},
        {"type":"url","id":"url","label":"Enlace"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Categorías 69",
      "blocks": [
        {"type":"category","settings":{"title":"Para ella","subtitle":"Pensado para ella"}},
        {"type":"category","settings":{"title":"Para él","subtitle":"Energía y resistencia"}},
        {"type":"category","settings":{"title":"Parejas","subtitle":"Para compartir"}},
        {"type":"category","settings":{"title":"Lencería","subtitle":"Sensualidad"}},
        {"type":"category","settings":{"title":"Lubricantes","subtitle":"Comodidad y juego"}}
      ]
    }
  ]
}
{% endschema %}
