<section class="section"><div class="container"><div class="section-head"><div><div class="eyebrow">Explora por categoría</div><h2 class="section-title">¿Qué estás buscando?</h2></div><p class="section-copy">Una navegación sencilla para encontrar exactamente lo que quieres, sin rodeos.</p></div><div class="category-grid">{% for block in section.blocks %}<a class="category-card" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>{% if block.settings.image %}<img src="{{ block.settings.image | image_url: width: 1000 }}" alt="{{ block.settings.title }}" loading="lazy">{% endif %}<div class="category-overlay"><div><strong>{{ block.settings.title }}</strong><span>{{ block.settings.subtitle }}</span></div></div></a>{% endfor %}</div></div></section>
{% schema %}{"name":"Categorías 69","max_blocks":8,"settings":[],"blocks":[{"type":"category","name":"Categoría","settings":[{"type":"image_picker","id":"image","label":"Imagen"},{"type":"text","id":"title","label":"Título","default":"Para ella"},{"type":"text","id":"subtitle","label":"Subtítulo","default":"Descubrir"},{"type":"url","id":"url","label":"Enlace"}]}],"presets":[{"name":"Categorías 69","blocks":[{"type":"category","settings":{"title":"Para ella","subtitle":"Deseo & bienestar"}},{"type":"category","settings":{"title":"Para él","subtitle":"Potencia & placer"}},{"type":"category","settings":{"title":"Parejas","subtitle":"Juntos es mejor"}},{"type":"category","settings":{"title":"Lencería","subtitle":"Sensualidad"}}]}]}{% endschema %}
