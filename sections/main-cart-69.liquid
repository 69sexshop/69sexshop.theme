<section class="cart"><div class="container"><div class="eyebrow">Tu selección</div><h1>Carrito.</h1>{% if cart.item_count > 0 %}{% form 'cart' %}{% for item in cart.items %}<div class="cart-row"><img src="{{ item.image | image_url: width: 240 }}" alt="{{ item.title | escape }}"><div><a href="{{ item.url }}">{{ item.product.title }}</a><div style="color:#77716b;font-size:12px">{{ item.variant.title }}</div></div><input class="qty" name="updates[]" value="{{ item.quantity }}" min="0" type="number"><div class="line-price">{{ item.final_line_price | money }}</div></div>{% endfor %}<div class="cart-total"><div class="total-line"><span>Total</span><strong>{{ cart.total_price | money }}</strong></div><button class="btn btn--solid" name="checkout" type="submit">Finalizar compra →</button></div>{% endform %}{% else %}<div class="empty">Tu carrito está vacío.<br><br><a class="btn" href="{{ routes.all_products_collection_url }}">Explorar tienda</a></div>{% endif %}</div></section>
{% schema %}{"name":"Carrito 69","settings":[],"presets":[{"name":"Carrito 69"}]}{% endschema %}
