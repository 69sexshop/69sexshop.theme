<section class="collection-head">
  <div class="container">
    <h1>{{ page.title | default: 'Selección privada' }}</h1>
    <p class="section-copy">Tus favoritos se guardan solo en este dispositivo y no se comparten.</p>
  </div>
</section>
<section class="collection-body">
  <div class="container">
    <div class="product-grid" data-fav-grid></div>
    <div class="empty" data-fav-empty hidden>
      <p>Aún no has guardado nada. Toca el corazón en un producto para verlo aquí.</p>
      <a class="btn" href="{{ routes.all_products_collection_url }}">Explorar tienda</a>
    </div>
  </div>
</section>
{% schema %}
{"name":"Favoritos 69","settings":[],"presets":[{"name":"Favoritos 69"}]}
{% endschema %}
