<section class="section finder">
  <div class="container">
    <div class="finder-box">
      <div class="finder-copy">
        <h2>{{ section.settings.title }}</h2>
        <p>{{ section.settings.text }}</p>
      </div>
      <div class="finder-options">
        {%- for block in section.blocks -%}
          {%- capture opt_url -%}{% render 'safe-url', url: block.settings.url %}{%- endcapture -%}
          <a href="{{ opt_url | strip }}" {{ block.shopify_attributes }}>
            <span>{{ block.settings.title }}</span>{% render 'icon', name: 'arrow' %}
          </a>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Finder 69",
  "max_blocks": 8,
  "settings": [
    {"type":"text","id":"title","label":"Título","default":"¿No sabes qué elegir?"},
    {"type":"textarea","id":"text","label":"Texto","default":"Cuéntanos qué buscas y te mostramos una selección hecha para eso."}
  ],
  "blocks": [
    {
      "type": "option",
      "name": "Opción",
      "settings": [
        {"type":"text","id":"title","label":"Texto","default":"Es mi primera vez"},
        {"type":"url","id":"url","label":"Colección o enlace"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Finder 69",
      "blocks": [
        {"type":"option","settings":{"title":"Es mi primera vez"}},
        {"type":"option","settings":{"title":"Es para mí"}},
        {"type":"option","settings":{"title":"Es para mi pareja"}},
        {"type":"option","settings":{"title":"Busco estimulación"}},
        {"type":"option","settings":{"title":"Busco lencería"}},
        {"type":"option","settings":{"title":"No estoy seguro"}}
      ]
    }
  ]
}
{% endschema %}
