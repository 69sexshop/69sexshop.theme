<section class="section trust">
  <div class="container">
    <h2 class="section-title">{{ section.settings.title }}</h2>
    <div class="trust-grid">
      {%- for block in section.blocks -%}
        <div class="trust-card" {{ block.shopify_attributes }}>
          <span class="trust-icon">{% render 'icon', name: block.settings.icon %}</span>
          <strong>{{ block.settings.title }}</strong>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Confianza 69",
  "max_blocks": 4,
  "settings": [
    {"type":"text","id":"title","label":"Título","default":"Tu privacidad es parte de la experiencia."}
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Beneficio",
      "settings": [
        {"type":"select","id":"icon","label":"Ícono","default":"box","options":[
          {"value":"box","label":"Paquete"},
          {"value":"shield","label":"Escudo"},
          {"value":"chat","label":"Chat"},
          {"value":"star","label":"Estrella"}
        ]},
        {"type":"text","id":"title","label":"Título","default":"Empaque discreto"},
        {"type":"textarea","id":"text","label":"Texto","default":"Empaque neutro, sin referencias al contenido."}
      ]
    }
  ],
  "presets": [
    {
      "name": "Confianza 69",
      "blocks": [
        {"type":"item","settings":{"icon":"box","title":"Empaque discreto","text":"Empaque neutro, sin referencias al contenido."}},
        {"type":"item","settings":{"icon":"shield","title":"Compra segura","text":"El pago se procesa con Wompi, una pasarela de pagos colombiana."}},
        {"type":"item","settings":{"icon":"chat","title":"Asesoría privada","text":"Te ayudamos a elegir por WhatsApp, sin juicios."}},
        {"type":"item","settings":{"icon":"star","title":"Productos seleccionados","text":"Una curaduría corta: curamos, no acumulamos."}}
      ]
    }
  ]
}
{% endschema %}
