<section class="hero">
  <div class="hero-media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2200 | image_tag: loading: 'eager', fetchpriority: 'high', alt: '' }}
    {%- endif -%}
  </div>
  <div class="container">
    <div class="hero-content">
      <h1>
        <span class="hero-line">{{ section.settings.line_1 }}</span>
        <span class="hero-line accent">{{ section.settings.line_accent }}</span>
        <span class="hero-line">{{ section.settings.line_3 }}</span>
      </h1>
      <p>{{ section.settings.text }}</p>
      <div class="hero-actions">
        <a class="btn btn--solid" href="{{ section.settings.button_url | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
        {%- if section.settings.secondary_label != blank -%}
          <a class="btn" href="{{ section.settings.secondary_url | default: routes.all_products_collection_url }}">{{ section.settings.secondary_label }}</a>
        {%- endif -%}
      </div>
      <ul class="trust-strip">
        {%- if section.settings.guarantee_1 != blank -%}<li>{{ section.settings.guarantee_1 }}</li>{%- endif -%}
        {%- if section.settings.guarantee_2 != blank -%}<li>{{ section.settings.guarantee_2 }}</li>{%- endif -%}
        {%- if section.settings.guarantee_3 != blank -%}<li>{{ section.settings.guarantee_3 }}</li>{%- endif -%}
      </ul>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Hero 69",
  "settings": [
    {"type":"image_picker","id":"image","label":"Imagen de fondo (editorial, oscura)"},
    {"type":"text","id":"line_1","label":"Título, línea 1","default":"El placer"},
    {"type":"text","id":"line_accent","label":"Título, línea en rojo cursiva","default":"tiene un nuevo"},
    {"type":"text","id":"line_3","label":"Título, línea 3","default":"lugar."},
    {"type":"textarea","id":"text","label":"Descripción","default":"Una selección de productos para adultos pensada para quienes buscan una experiencia íntima y una compra privada."},
    {"type":"text","id":"button_label","label":"Botón principal","default":"Explorar tienda"},
    {"type":"url","id":"button_url","label":"Enlace principal"},
    {"type":"text","id":"secondary_label","label":"Botón secundario","default":"Descubrir colección"},
    {"type":"url","id":"secondary_url","label":"Enlace secundario"},
    {"type":"text","id":"guarantee_1","label":"Garantía 1","default":"Envío discreto"},
    {"type":"text","id":"guarantee_2","label":"Garantía 2","default":"Pago seguro"},
    {"type":"text","id":"guarantee_3","label":"Garantía 3","default":"Privacidad total"}
  ],
  "presets": [{"name":"Hero 69"}]
}
{% endschema %}
