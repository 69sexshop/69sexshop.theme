{%- assign wa = settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' -%}
<section class="section faq" id="preguntas">
  <div class="container faq-grid">
    <div class="faq-copy">
      <h2>{{ section.settings.title }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      {%- if wa != blank -%}
        <a class="btn" href="https://wa.me/{{ wa }}" target="_blank" rel="noopener">{{ section.settings.button_label }}</a>
      {%- else -%}
        <a class="btn" href="{{ routes.root_url }}pages/contacto">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
    <div class="faq-list">
      {%- for block in section.blocks -%}
        <details class="faq-item" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="faq-answer rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>
<script type="application/ld+json">
  {"@context":"https://schema.org","@type":"FAQPage","mainEntity":[
  {%- for block in section.blocks -%}
    {"@type":"Question","name":{{ block.settings.question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ block.settings.answer | strip_html | json }}}}{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
  ]}
</script>
{% schema %}
{
  "name": "Preguntas frecuentes 69",
  "max_blocks": 12,
  "settings": [
    {"type":"text","id":"title","label":"Título","default":"Preguntas frecuentes"},
    {"type":"textarea","id":"text","label":"Texto","default":"Lo que más nos preguntan, resuelto en pocas líneas."},
    {"type":"text","id":"button_label","label":"Texto del botón","default":"¿Otra duda? Escríbenos"}
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Pregunta",
      "settings": [
        {"type":"text","id":"question","label":"Pregunta","default":"¿El empaque es discreto?"},
        {"type":"richtext","id":"answer","label":"Respuesta","default":"<p>Sí. Los pedidos se envían en empaque neutro, sin referencias al contenido.</p>"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Preguntas frecuentes 69",
      "blocks": [
        {"type":"faq","settings":{"question": "¿El empaque es discreto?", "answer": "<p>Sí. Los pedidos se envían en empaque neutro, sin referencias al contenido.</p>"}},
        {"type":"faq","settings":{"question": "¿Cómo pago mi pedido?", "answer": "<p>Pagas en línea con Wompi, una pasarela de pagos colombiana. Los medios de pago habilitados aparecen al finalizar la compra.</p>"}},
        {"type":"faq","settings":{"question": "¿Cuánto tarda mi pedido?", "answer": "<p>Depende de tu ciudad. El tiempo estimado se muestra al finalizar la compra y está detallado en la página de <a href=\"/pages/envios\">Envíos</a>.</p>"}},
        {"type":"faq","settings":{"question": "¿Cómo sé qué producto elegir?", "answer": "<p>Usa la guía «¿Te ayudo a elegir?» o escríbenos por WhatsApp y una persona del equipo te asesora en privado.</p>"}},
        {"type":"faq","settings":{"question": "¿Cuáles son los productos más vendidos?", "answer": "<p>Los reunimos en la sección <a href=\"/collections/mas-deseados\">Más deseados</a>, para que elijas sin dudar.</p>"}},
        {"type":"faq","settings":{"question": "¿Los productos son confiables?", "answer": "<p>Elegimos pocos productos y bien seleccionados: curamos, no acumulamos. Cada ficha trae su descripción y modo de uso, y si algo no sale como esperabas puedes escribirnos.</p>"}}
      ]
    }
  ]
}
{% endschema %}
