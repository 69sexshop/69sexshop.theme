{%- if settings.legal_name != blank -%}{%- assign empresa = settings.legal_name | escape -%}{%- else -%}{%- assign empresa = '<mark class="todo">[RAZÓN SOCIAL]</mark>' -%}{%- endif -%}
{%- if settings.nit != blank -%}{%- assign nit = settings.nit | escape -%}{%- else -%}{%- assign nit = '<mark class="todo">[NIT]</mark>' -%}{%- endif -%}
{%- if settings.address != blank -%}{%- assign direccion = settings.address | escape -%}{%- else -%}{%- assign direccion = '<mark class="todo">[DIRECCIÓN]</mark>' -%}{%- endif -%}
{%- if settings.contact_email != blank -%}{%- assign correo = settings.contact_email | escape -%}{%- else -%}{%- assign correo = '<mark class="todo">[CORREO]</mark>' -%}{%- endif -%}
<section class="page-head">
  <div class="container">
    <h1>{{ page.title }}</h1>
  </div>
</section>
<section class="container">
  <div class="page-content rte">
    {%- if page.content != blank -%}
      {{ page.content }}
    {%- else -%}
      {%- if request.design_mode -%}
        <p class="draft-note">Vista del editor: esta página muestra el borrador incluido en el tema. Lo resaltado en amarillo está pendiente de completar o revisar con un abogado. Si escribes contenido en la página de Shopify, ese contenido reemplaza el borrador.</p>
      {%- endif -%}
      {%- case page.handle -%}
      {%- when 'contacto' -%}{% render 'contact-form' %}
      {%- when 'favoritos' -%}
        <p class="section-copy">Tus favoritos se guardan solo en este dispositivo y no se comparten.</p>
        <div class="product-grid" data-fav-grid></div>
        <div class="empty" data-fav-empty hidden>
          <p>Aún no has guardado nada. Toca el corazón en un producto para verlo aquí.</p>
          <a class="btn" href="{{ routes.all_products_collection_url }}">Explorar tienda</a>
        </div>
      {%- when 'terminos' -%}{% render 'legal-terminos', empresa: empresa, nit: nit, direccion: direccion, correo: correo, tienda: shop.name %}
      {%- when 'privacidad' -%}{% render 'legal-privacidad', empresa: empresa, nit: nit, direccion: direccion, correo: correo, tienda: shop.name %}
      {%- when 'envios' -%}{% render 'legal-envios', empresa: empresa, nit: nit, direccion: direccion, correo: correo, tienda: shop.name %}
      {%- when 'retracto-y-devoluciones' -%}{% render 'legal-retracto-y-devoluciones', empresa: empresa, nit: nit, direccion: direccion, correo: correo, tienda: shop.name %}
      {%- when 'garantias' -%}{% render 'legal-garantias', empresa: empresa, nit: nit, direccion: direccion, correo: correo, tienda: shop.name %}
      {%- when 'pqr' -%}{% render 'legal-pqr', empresa: empresa, nit: nit, direccion: direccion, correo: correo, tienda: shop.name %}
      {%- when 'cookies' -%}{% render 'legal-cookies', empresa: empresa, nit: nit, direccion: direccion, correo: correo, tienda: shop.name %}
      {%- when 'aviso-18' -%}{% render 'legal-aviso-18', empresa: empresa, nit: nit, direccion: direccion, correo: correo, tienda: shop.name %}
      {%- endcase -%}
    {%- endif -%}
  </div>
</section>
{% schema %}
{"name":"Página 69","settings":[],"presets":[{"name":"Página 69"}]}
{% endschema %}
