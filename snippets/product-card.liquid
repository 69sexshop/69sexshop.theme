<a class="product-card" href="{{ product.url }}">{% if product.compare_at_price > product.price %}<span class="badge">Oferta</span>{% endif %}<div class="product-image">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | escape | default: product.title }}" loading="lazy">{% endif %}</div><div class="product-meta"><h3 class="product-title">{{ product.title }}</h3><div class="product-price">{{ product.price | money }}</div></div></a>
