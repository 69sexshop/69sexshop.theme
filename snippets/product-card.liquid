<article class="product-card">
  <button class="fav-btn" type="button" data-fav data-handle="{{ product.handle }}" aria-pressed="false" aria-label="Guardar {{ product.title | escape }} en favoritos">{% render 'icon', name: 'heart' %}</button>
  <a class="product-link" href="{{ product.url }}">
    <div class="product-image">
      {%- if product.available == false -%}
        <span class="badge badge--out">Agotado</span>
      {%- elsif product.compare_at_price > product.price -%}
        <span class="badge">Oferta</span>
      {%- endif -%}
      {%- if product.featured_image -%}
        {%- assign alt_text = product.featured_image.alt | default: product.title -%}
        {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 1000px) 25vw, 70vw', alt: alt_text }}
      {%- endif -%}
    </div>
    <div class="product-meta">
      <p class="product-title">{{ product.title }}</p>
      <div class="product-price">{{ product.price | money }}</div>
      {%- for option in product.options_with_values -%}
        {%- assign option_name = option.name | downcase -%}
        {%- if option_name == 'talla' and option.values.size > 1 -%}
          <div class="product-sizes">{{ option.values | join: ' · ' }}</div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </a>
</article>
