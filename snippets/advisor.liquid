{%- assign wa = settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' -%}
{%- capture existing_handles -%}{%- for c in collections -%}{{ c.handle }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}{%- endcapture -%}
<div class="advisor" data-advisor data-existing="{{ existing_handles | strip }}" data-collections="{{ routes.collections_url }}" data-root="{{ routes.root_url }}" data-wa="{{ wa }}" data-wa-msg="{{ settings.whatsapp_message | escape }}">
  <button class="advisor-launch" type="button" data-adv-open aria-expanded="false" aria-controls="AdvisorPanel">
    <span class="advisor-dot" aria-hidden="true"></span>¿Te ayudo a elegir?
  </button>
  <section class="advisor-panel" id="AdvisorPanel" role="dialog" aria-label="Guía 69" hidden>
    <header class="advisor-head">
      <div>
        <strong class="serif">Guía 69</strong>
        <span>Nada de esta conversación se guarda</span>
      </div>
      <button class="icon-btn" type="button" data-adv-close aria-label="Cerrar guía">{% render 'icon', name: 'close' %}</button>
    </header>
    <div class="advisor-log" data-adv-log aria-live="polite"></div>
    <div class="advisor-opts" data-adv-opts></div>
  </section>
</div>
<script src="{{ 'advisor.js' | asset_url }}" defer></script>
