        "q5",
        "q6"
      ]
    },
    "juices": {
      "type": "juices-69",
      "blocks": {
        "j1": {
          "type": "recipe",
          "settings": {
            "title": "Rubí",
            "subtitle": "Fresa, granada y jengibre",
            "time": "5 min",
            "tone": "rubi",
            "ingredients": "2|taza|de fresas (frescas o congeladas)\n0.5|taza|de granos de granada\n1|trozo|de jengibre fresco (2 cm)\n1|cucharada|de miel (opcional)\n1|taza|de agua fría\n||Hielo al gusto",
            "steps": "Lava las fresas y retira las hojas.\nLicúa las fresas con la granada, el jengibre pelado, la miel y el agua durante un minuto.\nPrueba y ajusta la dulzura; si quieres, cuélalo.\nSírvelo bien frío, con hielo.",
            "pairing_label": "Parejas",
            "url": "/collections/parejas"
          }
        },
        "j2": {
          "type": "recipe",
          "settings": {
            "title": "Terciopelo",
            "subtitle": "Cacao, banano y canela",
            "time": "5 min",
            "tone": "cacao",
            "ingredients": "2|banano|\n2|cucharada|de cacao puro en polvo\n1|taza|de leche (o bebida vegetal)\n1|pizca|de canela\n||Hielo al gusto",
            "steps": "Pela los bananos maduros y trocéalos.\nLicúa con el cacao, la leche y la canela hasta que quede cremoso.\nSírvelo enseguida, con hielo si lo prefieres.",
            "pairing_label": "Lencería",
            "url": "/collections/lenceria"
          }
        },
        "j3": {
          "type": "recipe",
          "settings": {
            "title": "Brisa",
            "subtitle": "Sandía, menta y limón",
            "time": "5 min",
            "tone": "sandia",
            "ingredients": "3|taza|de sandía en cubos (sin semillas)\n10|hoja|de menta fresca\n1|limón|(solo el jugo)\n||Hielo al gusto",
            "steps": "Licúa la sandía con la menta y el jugo del limón.\nCuela si prefieres una textura más ligera.\nSírvelo con hielo y una hoja de menta.",
            "pairing_label": "Lubricantes",
            "url": "/collections/lubricantes"
          }
        },
        "j4": {
          "type": "recipe",
          "settings": {
            "title": "Trópico",
            "subtitle": "Mango, maracuyá y jengibre",
            "time": "5 min",
            "tone": "mango",
            "ingredients": "1|mango|\n2|maracuyá|(solo la pulpa)\n1|taza|de agua fría\n1|cucharadita|de jengibre rallado\n1|cucharada|de miel (opcional)",
            "steps": "Pela el mango y córtalo en trozos.\nLicúa con la pulpa del maracuyá, el jengibre, la miel y el agua.\nCuela las semillas si prefieres.\nSírvelo muy frío.",
            "pairing_label": "Combos 69",
            "url": "/collections/combos"
          }
        }
      },
